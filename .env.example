# Backend host for the Next.js API proxy
NEXT_PUBLIC_API_HOST=http://localhost:3001

# Marketing site origin (used for cross-app links back to anchora-website)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PostHog ──────────────────────────────────────
# Project → Settings → Project API Key — same project as anchora-website
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
