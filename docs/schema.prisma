generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────

enum Plan {
  FREE
  PRO
}

enum RenewalStatus {
  current
  expiring_soon
  auto_charge_failed
  expired
}


enum AdminRole {
  SUPER_ADMIN
  ADMIN
  READ_ONLY
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

enum MFAMethod {
  TOTP
  SMS
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum InactivityStatus {
  ACTIVE
  NOTIFIED
  RELEASING
}

enum AssetCategory {
  BANK_ACCOUNT
  INVESTMENT_PLATFORM
  CRYPTO_WALLET
  PENSION_PORTAL
  INSURANCE_POLICY
  FOREIGN_ACCOUNT
  REAL_ESTATE
  VEHICLE
  JEWELRY_WATCHES
  SHARE_CERTIFICATES
  SUBSCRIPTION
  OTHER
}

enum ExecutorIntent {
  LIQUIDATE
  TRANSFER
  HOLD
  UNSPECIFIED
}

// Account-level government-ID verification (NIN + selfie, via Dojah) — the
// single identity-verification mechanism for every use case (release-report
// download for a trusted contact, etc). Synchronous check: no PENDING state,
// resolves to VERIFIED/FAILED immediately.
enum GovIdVerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

enum Relationship {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  FRIEND
  LAWYER
  OTHER
}

enum BeneficiaryStatus {
  INVITED
  ACCOUNT_CREATED
  ACTIVE
  ACCOUNT_DELETED
}

enum ReleaseStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// Only used by the deprecated Beneficiary/BeneficiaryRelease models now —
// ExecutorRelease's own verification fields were removed in favor of the
// single account-level GovIdVerificationStatus check.
enum VerificationStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  PERMANENTLY_REJECTED
}

enum NotificationType {
  REGISTRATION
  EMAIL_VERIFIED
  NEW_LOGIN
  ACCOUNT_LOCKED
  PASSWORD_RESET
  PASSWORD_RESET_CONFIRMED
  INACTIVITY_STAGE_1
  INACTIVITY_STAGE_2
  INACTIVITY_STAGE_3
  ACTIVITY_CONFIRMED
  ANNUAL_REVIEW
  BENEFICIARY_ACCOUNT_DELETED
  ACCOUNT_DELETION_INITIATED
  BENEFICIARY_INVITATION
  BENEFICIARY_INVITATION_EXISTING
  RELEASE_INITIATED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  RELEASE_CANCELLED
  GUARDIAN_INVITED
  GUARDIAN_ACCEPTED
  GUARDIAN_DECLINED
  RENEWAL_UPCOMING
  RENEWAL_AUTO_CHARGE_FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum ActorType {
  USER
  BENEFICIARY
  ADMIN
  SYSTEM
}

// ─── MODELS ──────────────────────────────────────

model AdminUser {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  email         String    @unique
  passwordHash  String
  role          AdminRole @default(ADMIN)
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  createdById   String?
  createdBy     AdminUser?  @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins AdminUser[] @relation("AdminCreatedBy")

  initiatedActions PendingAction[] @relation("InitiatedActions")
  confirmedActions PendingAction[] @relation("ConfirmedActions")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model PendingAction {
  id            String              @id @default(cuid())
  createdAt     DateTime            @default(now())
  actionToken   String              @unique
  actionType    String
  payload       Json
  initiatedById String
  initiatedBy   AdminUser           @relation("InitiatedActions", fields: [initiatedById], references: [id])
  expiresAt     DateTime
  confirmedById String?
  confirmedBy   AdminUser?          @relation("ConfirmedActions", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  status        PendingActionStatus @default(PENDING)

  @@index([actionToken])
  @@index([initiatedById])
  @@index([confirmedById])
  @@index([status])
  @@index([expiresAt])
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  firstName       String
  lastName        String
  passwordHash    String?
  googleId        String?   @unique
  facebookId      String?   @unique
  mfaSecret       String?
  mfaMethod       MFAMethod?
  phoneNumber     String?
  role            UserRole        @default(USER)
  status          AccountStatus   @default(ACTIVE)
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  onboardingSelectedCategories AssetCategory[] @default([])
  lastActivityAt        DateTime        @default(now())
  inactivityStatus    InactivityStatus @default(ACTIVE)
  notifiedAt          DateTime?
  lastReminderSentAt  DateTime?
  reminderFrequencyDays   Int     @default(30)
  inactivityWindowMonths  Int     @default(3)
  plan              Plan      @default(FREE)
  planActivatedAt   DateTime?
  lastRenewalNudgeSentAt DateTime?
  deletedAt       DateTime?
  govIdVerificationStatus       GovIdVerificationStatus @default(UNVERIFIED)
  govIdVerifiedAt               DateTime?
  acquisitionSource      String?
  acquisitionMedium      String?
  acquisitionCampaign    String?
  acquisitionContent     String?
  landingPage            String?
  firstTouchAt           DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sessions            Session[]
  mfaRecoveryCodes    MFARecoveryCode[]
  vaultRecords        VaultRecord[]
  beneficiaries       Beneficiary[]
  inactivityEvents    InactivityEvent[]
  releases            Release[]
  notifications       Notification[]
  beneficiaryAccounts BeneficiaryAccount[] @relation("BeneficiaryAccountOwner")
  executors           Executor[]
  billing             Billing?

  @@index([email])
  @@index([status])
  @@index([inactivityStatus])
  @@index([lastActivityAt])
  @@index([govIdVerificationStatus])
  @@index([acquisitionSource])
}

model Billing {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  paidUntil              DateTime?
  renewalStatus          RenewalStatus?
  authorizationCode      String?
  customerCode           String?
  subscriptionCode       String?
  subscriptionEmailToken String?
  cardLast4              String?
  lastProcessedReference String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([renewalStatus])
  @@index([paidUntil])
}

model MFARecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  ipAddress        String
  userAgent        String
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VaultRecord {
  id                  String         @id @default(cuid())
  userId              String
  category            AssetCategory
  institutionName     String
  accountName         String?
  accountUrl          String?
  executorIntent      ExecutorIntent @default(UNSPECIFIED)
  intendedBeneficiary String?
  isSelfCustodied     Boolean        @default(false)
  encryptedData       String // includes estimatedValue (kobo) alongside the other encrypted fields
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaries VaultRecordBeneficiary[]
  documents     VaultRecordDocument[]

  @@index([userId])
  @@index([userId, category])
}

model VaultRecordDocument {
  id               String   @id @default(cuid())
  vaultRecordId    String
  userId           String
  r2Key            String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  vaultRecord  VaultRecord           @relation(fields: [vaultRecordId], references: [id], onDelete: Cascade)
  accessTokens DocumentAccessToken[]

  @@index([vaultRecordId])
  @@index([userId])
}

model DocumentAccessToken {
  id         String   @id @default(cuid())
  documentId String
  releaseId  String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())

  document VaultRecordDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  release  Release              @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([releaseId])
}

model Executor {
  id           String    @id @default(uuid())
  userId       String
  name         String
  email        String
  phone        String?
  relationship String?
  invitedAt    DateTime  @default(now())
  removedAt    DateTime?

  notifiedAt              DateTime?
  verificationToken       String?
  verificationTokenSentAt DateTime?
  emailVerifiedAt         DateTime?
  acceptedAt              DateTime?
  declinedAt              DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executorReleases ExecutorRelease[]

  // Case-insensitive duplicate guard on (userId, lower(email)) is enforced by
  // a raw unique index (see migration add_executor_email_ci_unique) — Prisma
  // can't express a functional index in the schema DSL, so it isn't declared
  // here. Do not re-add a plain @@unique([userId, email]); it would be
  // case-sensitive and conflict with that index.
  @@index([userId])
  @@index([verificationToken])
}

model ExecutorRelease {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  releaseId  String
  executorId String

  release  Release  @relation(fields: [releaseId], references: [id])
  executor Executor @relation(fields: [executorId], references: [id])

  @@unique([releaseId, executorId])
  @@index([executorId])
  @@index([releaseId])
}

// @deprecated — replaced by Executor model.
// Retained for Sprint 5 release workflow
// compatibility. Do not add new relations.
model Beneficiary {
  id           String            @id @default(cuid())
  userId       String
  name         String
  email        String
  phone        String?
  relationship Relationship
  isDefault    Boolean           @default(false)
  inviteToken  String?
  status       BeneficiaryStatus @default(INVITED)
  invitedAt    DateTime          @default(now())
  acceptedAt   DateTime?

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultRecords VaultRecordBeneficiary[]
  account      BeneficiaryAccount?
  releases     BeneficiaryRelease[]

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
  @@index([userId, isDefault])
}

model VaultRecordBeneficiary {
  id            String   @id @default(cuid())
  vaultRecordId String
  beneficiaryId String
  assignedAt    DateTime @default(now())

  vaultRecord VaultRecord @relation(fields: [vaultRecordId], references: [id], onDelete: Cascade)
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([vaultRecordId, beneficiaryId])
  @@index([vaultRecordId])
  @@index([beneficiaryId])
}

model BeneficiaryAccount {
  id            String   @id @default(cuid())
  beneficiaryId String   @unique
  accountUserId String
  linkedAt      DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  accountUser User        @relation("BeneficiaryAccountOwner", fields: [accountUserId], references: [id])

  @@index([accountUserId])
}

model InactivityEvent {
  id          String          @id @default(cuid())
  userId      String
  status      InactivityStatus
  triggeredAt DateTime         @default(now())
  notifiedAt  DateTime?
  cancelled   Boolean          @default(false)
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model Release {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  status       ReleaseStatus @default(PENDING)
  triggeredAt  DateTime      @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  emptyVault           Boolean       @default(false)
  reportUrl            String?
  reportS3Key          String?
  reportUrlGeneratedAt DateTime?

  user                 User                  @relation(fields: [userId], references: [id])
  report               ReleaseReport?
  executorReleases     ExecutorRelease[]
  beneficiaries        BeneficiaryRelease[]
  documentAccessTokens DocumentAccessToken[]

  @@index([userId])
  @@index([status])
}

model BeneficiaryRelease {
  id                    String             @id @default(cuid())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  releaseId             String
  beneficiaryId         String
  verificationStatus    VerificationStatus @default(PENDING)
  submittedAt           DateTime?
  reviewedAt            DateTime?
  rejectionReason       String?
  resubmittedAt         DateTime?
  reportAccessGrantedAt DateTime?
  smileJobId            String?
  idDocumentKey         String?
  selfieKey             String?
  reviewedByAdminId     String?

  release     Release     @relation(fields: [releaseId], references: [id])
  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id])

  @@index([releaseId])
  @@index([beneficiaryId])
  @@index([verificationStatus])
}

model ReleaseReport {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  releaseId     String   @unique
  s3Key         String
  generatedAt   DateTime @default(now())
  fileSizeBytes Int?

  release Release @relation(fields: [releaseId], references: [id])
}

model Notification {
  id             String              @id @default(cuid())
  userId         String
  type           NotificationType
  channel        NotificationChannel
  deliveryStatus String              @default("sent")
  sentAt         DateTime            @default(now())
  deliveredAt    DateTime?
  metadata       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([sentAt])
}

// AuditLog deliberately has no FK relations.
// Audit records must survive user deletion.
// actorId and targetId are plain strings —
// they record who did what even after the
// referenced records no longer exist.
model AuditLog {
  id         String    @id @default(cuid())
  actorId    String
  actorType  ActorType
  action     String
  targetType String
  targetId   String
  ipAddress  String?
  userAgent  String?
  result     String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
